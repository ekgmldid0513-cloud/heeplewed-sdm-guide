    ".write": false,

    "studios":  { ".read": true, ".write": "auth != null" },
    "concepts": { ".read": true, ".write": "auth != null" },
    "dresses":  { ".read": true, ".write": "auth != null" },
    "makeup":   { ".read": true, ".write": "auth != null" },
